{
  "name": "localllm-agents",
  "version": "0.4.0",
  "description": "Multi-Agent System for Local LLMs (Ollama, LM Studio, llama.cpp, vLLM)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "localllm": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "scripts/sync-skills.js",
    "src/agents/builtin/**/*.md",
    "src/rules/builtin/**/*.md",
    "src/skills/builtin/**"
  ],
  "scripts": {
    "build": "tsc",
    "build:exe": "node build-exe.js",
    "build:deploy": "node scripts/build-deploy.js --verbose",
    "setup:git-hooks": "node scripts/install-git-hooks.mjs",
    "sync:skills": "node scripts/sync-skills.js --verbose",
    "validate:skills": "node scripts/validate-skill.mjs --root src/skills/builtin --root .localllm/skills --root .claude/skills",
    "validate:package": "node scripts/validate-npm-package.mjs",
    "validate:commits": "node scripts/validate-commit-messages.mjs",
    "start": "tsx src/index.ts",
    "setup": "tsx src/index.ts --setup",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:pty": "node scripts/pty-smoke.mjs",
    "test:all": "vitest run && vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && biome check .",
    "format": "biome format --write .",
    "analyze:loop": "node scripts/analyze-loop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.144",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@slack/bolt": "^4.1.0",
    "chalk": "^5.4.1",
    "glob": "^11.0.1",
    "inquirer": "^12.3.2",
    "jimp": "^1.6.1",
    "marked": "^15.0.6",
    "marked-terminal": "^7.3.0",
    "ora": "^8.1.1",
    "playwright": "^1.50.1",
    "undici": "^7.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.13.5",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.27.3",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
