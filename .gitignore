node_modules/
dist/
*.js.map
*.d.ts.map
.env
.env.local
coverage/
.vitest/
*.log
*.zip

# Workspace separation (docs/workspace-separation.md)
# sandbox/ は許可リスト方式: 下記以外 (lllmAgents の実行で生成された検証成果物、
# 一時スクリプト、入れ子の別リポジトリ等) は追跡しない
sandbox/*
!sandbox/README.md
!sandbox/run.bat
!sandbox/run.sh
!sandbox/scripts/
!sandbox/artifacts/
!sandbox/output/
!sandbox/screenshots/
# scripts/ 内でも lllmAgents が生成した使い捨てスクリプトは除外
sandbox/scripts/migrate_vault*.mjs
sandbox/artifacts/*
sandbox/output/*
sandbox/screenshots/*
!sandbox/artifacts/.gitkeep
!sandbox/output/.gitkeep
!sandbox/screenshots/.gitkeep

# deploy/ はビルド成果物のみ ignore、配布用アセットは scripts/deploy-assets/ から組み立てる
deploy/localllm.exe
deploy/localllm
deploy/localllm.cjs
deploy/skills/
deploy/agents/
deploy/.deploy-meta.json
deploy/install.bat
deploy/install.sh
deploy/README.md

# Local settings
.claude/settings.local.json

# Windows null device artifact
$null

# Python artifacts
__pycache__/
*.pyc

# Temporary/test files
src/Level.js
src/test-Level.js

# macOS metadata
.DS_Store
**/.DS_Store

# ローカル動作ログ・キャッシュ (~/.localllm を除く repo 内 transcript 用)
.localllm/transcripts/

# proj/ 配下は個別リポジトリで管理 (別コミット運用)
proj/
